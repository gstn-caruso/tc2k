; Engine configuration file. Edit project settings through the Godot editor.
config_version=5

[application]

config/name="TC2K"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.039, 0.051, 1)
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Localization="*res://scripts/localization.gd"
RaceSetup="*res://scripts/race_setup.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

drive_accelerate={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode": 87), Object(InputEventKey,"keycode": 4194320)]
}
drive_brake={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode": 83), Object(InputEventKey,"keycode": 4194322)]
}
drive_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode": 65), Object(InputEventKey,"keycode": 4194319)]
}
drive_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode": 68), Object(InputEventKey,"keycode": 4194321)]
}
car_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode": 82)]
}
race_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194305)]
}
menu_confirm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194309), Object(InputEventKey,"keycode": 4194310)]
}
menu_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194320)]
}
menu_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194322)]
}
menu_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194319)]
}
menu_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194321)]
}
menu_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode": 4194305)]
}

[internationalization]

locale/fallback="es"
locale/translations=PackedStringArray("res://assets/i18n/messages.en.translation", "res://assets/i18n/messages.es.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.09, 1)
